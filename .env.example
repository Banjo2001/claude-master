# =============================================================================
# .env.example — Variablen-Vorlage
# ZWECK: Vorlage für die .env-Datei. Alle echten Werte in .env eintragen.
#        DIESE DATEI wird ins Repo committed — NIEMALS echte Werte hier!
#        Die .env-Datei liegt in .gitignore und bleibt lokal.
#
# SETUP:
#   cp .env.example .env
#   nano .env   # Platzhalter durch echte Werte ersetzen
# =============================================================================

# ─── Proxmox VE ──────────────────────────────────────────────────────────────
# Die IP-Adresse oder der Hostname des Proxmox-VE-Servers
PVE_HOST=192.0.2.10

# Proxmox API-Port (Standard: 8006)
PVE_PORT=8006

# API-Token ID im Format: <USER>@<REALM>!<TOKEN_NAME>
# Beispiel: admin@pam!infra-token
# Erstellen in Proxmox Web-UI: Rechenzentrum → API-Tokens
PVE_TOKEN_ID=<DEIN_USER>@pam!<TOKEN_NAME>

# API-Token Secret (UUID, wird beim Erstellen angezeigt)
# NIEMALS in diese Datei eintragen — nur in .env!
PVE_TOKEN_SECRET=<DEIN_TOKEN_SECRET>

# TLS-Verifikation: true (empfohlen) oder false (für self-signed Zertifikate)
# In Produktion: true und Zertifikat von vertrauenswürdiger CA verwenden
# WARUM PVE_VERIFY_SSL: Variablenname wird von proxmox-api/lib/pve_api.sh gelesen.
PVE_VERIFY_SSL=false

# Node-Name (wie in Proxmox Web-UI angezeigt, z.B. "pve", "proxmox01")
PVE_NODE=pve

# ─── Proxmox Backup Server ───────────────────────────────────────────────────
# IP-Adresse des PBS-Servers
PBS_HOST=192.0.2.11

# PBS API-Port (Standard: 8007)
PBS_PORT=8007

# PBS API-Token ID
PBS_TOKEN_ID=<DEIN_USER>@pbs!<TOKEN_NAME>

# PBS API-Token Secret
PBS_TOKEN_SECRET=<DEIN_TOKEN_SECRET>

# PBS Datastore-Name (in PBS Web-UI sichtbar)
PBS_DATASTORE=<DATASTORE_NAME>

# PBS TLS-Verifikation
# WARUM PBS_VERIFY_SSL: Variablenname wird von proxmox-api/lib/pbs_api.sh gelesen.
PBS_VERIFY_SSL=false

# ─── Claude Code ─────────────────────────────────────────────────────────────
# Anthropic API-Key für Claude Code
# HINWEIS: Besser in ~/.bashrc oder ~/.anthropic_secrets setzen
# NIEMALS in diese Datei oder .env.example eintragen!
# ANTHROPIC_API_KEY=<DEIN_API_KEY>

# ─── Git ─────────────────────────────────────────────────────────────────────
# Git-Benutzer für Commits auf dem Control-Node
GIT_USER_NAME=<DEIN_NAME>
GIT_USER_EMAIL=<DEINE_EMAIL>

# ─── Ansible ─────────────────────────────────────────────────────────────────
# Pfad zur Ansible Vault Passwort-Datei (AUSSERHALB des Repos!)
ANSIBLE_VAULT_PASSWORD_FILE=~/.vault_pass.txt

# ─── Allgemein ───────────────────────────────────────────────────────────────
# Zeitzone für alle Server
TIMEZONE=Europe/Berlin

# Admin-E-Mail (für Let's Encrypt und Benachrichtigungen)
ADMIN_EMAIL=<DEINE_EMAIL>

# Domain für Matrix Synapse (z.B. example.com)
# WICHTIG: Dieser Wert bestimmt die Matrix-Server-ID und kann NICHT mehr geändert werden!
MATRIX_DOMAIN=<DEINE_DOMAIN>

# Subdomain für den Matrix-Server (z.B. matrix.example.com)
MATRIX_SERVER_DOMAIN=matrix.<DEINE_DOMAIN>

# Domain für Nextcloud (z.B. cloud.example.com)
NEXTCLOUD_DOMAIN=cloud.<DEINE_DOMAIN>
