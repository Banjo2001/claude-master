# =============================================================================
# .env.example — Nextcloud AIO Umgebungsvariablen
# KOPIEREN:  cp .env.example .env
# WICHTIG:   .env enthält keine Secrets — AIO verwaltet Passwörter intern
#            über das Admin-Interface (Port 8080)
# =============================================================================

# ─── Ports ────────────────────────────────────────────────────────────────────
# Admin-Interface: NUR über IP erreichbar (https://<IP>:ADMIN_PORT)
ADMIN_PORT=8080
# Nextcloud HTTPS
HTTPS_PORT=8443

# ─── Verzeichnisse ────────────────────────────────────────────────────────────
NEXTCLOUD_DATA_DIR=/opt/nextcloud-aio/data

# ─── Performance ──────────────────────────────────────────────────────────────
NEXTCLOUD_UPLOAD_LIMIT=10G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M

# ─── System ───────────────────────────────────────────────────────────────────
TIMEZONE=Europe/Berlin
