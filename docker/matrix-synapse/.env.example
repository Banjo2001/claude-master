# =============================================================================
# .env.example — Matrix Synapse Stack Umgebungsvariablen
# KOPIEREN:  cp .env.example .env
# SICHERHEIT: .env NIEMALS ins Git! (ist in .gitignore ausgeschlossen)
# =============================================================================

# ─── Domain ───────────────────────────────────────────────────────────────────
MATRIX_DOMAIN=<DEINE_MATRIX_DOMAIN>

# ─── Image-Versionen (NIEMALS :latest außer AIO Mastercontainer) ──────────────
SYNAPSE_VERSION=v1.123.0
POSTGRES_VERSION=16.4
REDIS_VERSION=7.2-alpine
NGINX_VERSION=1.27-alpine
COTURN_VERSION=4.6

# ─── Datenbank ────────────────────────────────────────────────────────────────
DB_USER=synapse
DB_PASSWORD=<SICHERES_PASSWORT_HIER>
DB_NAME=synapse

# ─── Verzeichnisse ────────────────────────────────────────────────────────────
BASE_DIR=/opt/matrix
DATA_DIR=/opt/matrix/data

# ─── Coturn ───────────────────────────────────────────────────────────────────
COTURN_AUTH_SECRET=<ZUFAELLIGES_SECRET_MIN_32_ZEICHEN>
