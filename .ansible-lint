# =============================================================================
# .ansible-lint — ansible-lint Konfiguration
# ZWECK: Regeln für ansible-lint — prüft Ansible Best Practices
# =============================================================================

# Profile: basic ist ausreichend für diese Projektphase
profile: basic

# Verzeichnisse ausschließen
exclude_paths:
  - .git/
  - .ansible/
  - docs/

# Regeln die wir deaktivieren (mit Begründung):
skip_list:
  # no-changed-when: Manchmal unvermeidbar bei Shell-Tasks mit sshd -t
  - no-changed-when
  # var-naming: Gemeinsame Variablen (timezone, ssh_port) ohne Rollen-Präfix
  # sind gängige Praxis bei shared vars zwischen Rollen
  - var-naming[no-role-prefix]

warn_list:
  # Diese Regeln erzeugen Warnungen, keine Fehler
  - yaml[line-length]
  - experimental

# FQCN (Fully Qualified Collection Name) erzwingen
# z.B. ansible.builtin.apt statt nur apt
use_default_rules: true
