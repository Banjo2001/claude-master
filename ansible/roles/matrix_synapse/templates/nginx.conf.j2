# =============================================================================
# nginx.conf — Nginx Reverse Proxy für Matrix Synapse
# AUTOMATISCH GENERIERT durch Ansible
# KRITISCH: proxy_pass OHNE trailing slash! http://synapse:8008 (kein /)
# =============================================================================

# HTTP → HTTPS Redirect
server {
    listen 80;
    server_name matrix.{{ matrix_domain }};
    return 301 https://$host$request_uri;
}

# HTTPS — Matrix Client und Federation
server {
    listen 443 ssl;
    http2 on;
    server_name matrix.{{ matrix_domain }};

    ssl_certificate /etc/nginx/certs/live/matrix.{{ matrix_domain }}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/matrix.{{ matrix_domain }}/privkey.pem;

    # Moderne TLS-Einstellungen
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Maximale Upload-Größe (für Matrix-Dateiübertragungen)
    client_max_body_size {{ matrix_nginx_client_max_body_size }};

    # ─── Matrix Client API ───────────────────────────────────────────────────
    location /_matrix {
        # KRITISCH: Kein trailing slash! Sonst Signaturfehler bei Federation
        proxy_pass http://synapse:{{ matrix_synapse_port }};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        # WebSocket-Unterstützung
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Timeouts für lange Polling-Verbindungen
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # ─── Synapse Admin API ───────────────────────────────────────────────────
    location /_synapse {
        proxy_pass http://synapse:{{ matrix_synapse_port }};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
    }

    # ─── .well-known für Federation ──────────────────────────────────────────
    location /.well-known/matrix/server {
        return 200 '{"m.server":"matrix.{{ matrix_domain }}:443"}';
        add_header Content-Type application/json;
    }

    location /.well-known/matrix/client {
        return 200 '{"m.homeserver":{"base_url":"https://matrix.{{ matrix_domain }}"}}';
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin *;
    }
}
