# =============================================================================
# coturn.conf — Coturn TURN-Server Konfiguration
# AUTOMATISCH GENERIERT durch Ansible
# =============================================================================

listening-port={{ coturn_listening_port }}
tls-listening-port={{ coturn_tls_listening_port }}

min-port={{ coturn_min_port }}
max-port={{ coturn_max_port }}

realm={{ coturn_realm }}

# TURN-Authentifizierung (shared secret mit Matrix Synapse)
use-auth-secret
static-auth-secret={{ vault_coturn_auth_secret }}

# TLS-Zertifikate
# WARUM dieser Pfad: compose.yml mountet matrix_base_dir/certs → /etc/ssl
# Let's Encrypt legt Zertifikate unter live/<DOMAIN>/ ab.
cert=/etc/ssl/live/matrix.{{ matrix_domain }}/fullchain.pem
pkey=/etc/ssl/live/matrix.{{ matrix_domain }}/privkey.pem

# Logging
log-file=/var/log/coturn/turnserver.log
verbose

# WARUM KEIN no-auth: use-auth-secret und no-auth schließen sich aus!
# no-auth würde alle Authentifizierung deaktivieren — Sicherheitslücke.
# Mit use-auth-secret nutzt Coturn HMAC-basierte REST-API Auth (Matrix-kompatibel).

# Sicherheit: nur TURN erlauben (kein STUN-only)
no-stun
